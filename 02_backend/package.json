{
  "name": "transmetro-sic-api",
  "version": "0.1.0",
  "description": "API REST del Sistema de Informacion y Control del Transmetro",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:reset": "node scripts/aplicar-sql.js --reset",
    "db:migrate": "node scripts/aplicar-sql.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "db:local": "node scripts/servidor-pglite.js",
    "db:local:reset": "node scripts/servidor-pglite.js --reset",
    "demo": "node scripts/servidor-demo.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
