# =============================================================================
# SIC Transmetro - API REST
# Copiar a .env y completar. NUNCA versionar el archivo .env real.
# =============================================================================

NODE_ENV=development
PORT=4000

# --- Base de datos (PostgreSQL administrado en la nube) ----------------------
# Formato: postgresql://usuario:password@host:5432/base?sslmode=require
DATABASE_URL=postgresql://transmetro_app:cambiar@localhost:5432/transmetro
DB_SSL=false
DB_POOL_MAX=10
DB_SCHEMA=transmetro

# --- Autenticacion -----------------------------------------------------------
# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-distinto
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Politica de bloqueo por intentos fallidos
MAX_INTENTOS_FALLIDOS=5
MINUTOS_BLOQUEO=15

# --- CORS --------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# Nota: PGlite (npm run db:local) atiende una conexion a la vez.
# Con un PostgreSQL real se puede subir DB_POOL_MAX a 10.
